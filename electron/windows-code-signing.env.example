# Windows Authenticode signing for electron-builder (local/CI only).
# Do NOT commit real passwords or PFX files.
#
# When both are set, electron-builder signs NSIS + win-unpacked executables.
# Leave unset for unsigned local validation builds.
#
# CSC_LINK=C:\secure\path\to\certificate.pfx
# CSC_LINK can also be a base64-encoded PFX (electron-builder convention).
# CSC_KEY_PASSWORD=
#
# Optional subject filter if multiple certs in store:
# CSC_NAME=
#
# Local unsigned build (no publish):
#   npm run build:win:local
#
# Verify after build (PowerShell):
#   Get-AuthenticodeSignature .\release\DentiSuite-Setup-<version>.exe
