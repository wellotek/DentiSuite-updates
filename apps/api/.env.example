# DentiSuite API — environment template (Phase 5F)
# Copy to .env and fill with a DEDICATED development database.
# NEVER commit real credentials.

NODE_ENV=development
PORT=3001

# Required. Dedicated development PostgreSQL — never customer production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dentisuite_dev
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/dentisuite_dev

# Optional auth tuning
# SESSION_TTL_SECONDS=2592000
# PASSWORD_MIN_LENGTH=10
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX=20
# TRUST_PROXY=true
# ALLOW_OPEN_ORG_CREATE=false
# LOG_LEVEL=info

# Railway production: set TRUST_PROXY=true so rate-limit keys use the
# platform-provided X-Forwarded-For. Leave unset/false locally.

# Object storage (default memory for local/tests)
OBJECT_STORAGE_PROVIDER=memory
# MEDIA_SIGNED_URL_TTL_SECONDS=300

# Cloudflare R2 (when OBJECT_STORAGE_PROVIDER=r2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
